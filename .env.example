POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=finance_ai

DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/finance_ai

NEXT_PUBLIC_API_URL=http://localhost:8000

DEBUG=false

# ── AI Provider ────────────────────────────────────────────────────────────────
# Values: mock | openrouter
AI_PROVIDER=mock
OPENROUTER_API_KEY=your-openrouter-api-key-here
OPENROUTER_MODEL_PRIMARY=deepseek/deepseek-v3.2
OPENROUTER_MODEL_FALLBACK=deepseek/deepseek-chat

# ── AI Behaviour ───────────────────────────────────────────────────────────────
AI_MAX_INPUT_CHARS=2000
AI_MAX_OUTPUT_TOKENS=500
AI_TEMPERATURE=0

# ── AI Rate Limits ─────────────────────────────────────────────────────────────
AI_DAILY_REQUEST_LIMIT=20
AI_MONTHLY_REQUEST_LIMIT=200
AI_COOLDOWN_SECONDS=5
AI_MONTHLY_BUDGET_USD=10
AI_USER_MONTHLY_BUDGET_USD=0.25

# Telegram: copy values into .env; never commit real keys.
TELEGRAM_BOT_TOKEN=
TELEGRAM_INTERNAL_SECRET=
TELEGRAM_BOT_USERNAME=FinAI_sychikoff_bot
BACKEND_INTERNAL_URL=http://backend:8000
TRANSCRIPTION_MODEL=openai/whisper-1
# Telegram Mini App. The startup script supplies the temporary HTTPS URL.
MINIAPP_AUTH_MAX_AGE_SECONDS=3600
# MINIAPP_URL=https://your-host/miniapp
# Optional PEM of an already trusted local HTTPS proxy root (inside container).
# AI_CA_FILE=/app/.local-ca/host-root.pem
